# ─────────────────────────────────────────────────────────────
# Firevolv — env template. Copy to .env and fill in real values.
#   cp .env.example .env
# Never put real keys in this file; it IS committed.
# ─────────────────────────────────────────────────────────────

# --- Pioneer (serves Claude judge + GliGuard + embeddings) ---
PIONEER_API_KEY=            # personal API key -> judge + embeddings
PIONEER_GLIGUARD_API_KEY=   # GliGuard-scoped key -> guard-model calls
PIONEER_BASE_URL=
PIONEER_JUDGE_MODEL=claude-opus
PIONEER_GUARD_MODEL=gliguard
PIONEER_EMBED_MODEL=        # blank -> local MiniLM fallback

# --- Vector store for the learning loop ---
FIREVOLV_STORE=memory          # "memory" (zero-setup) or "actian"
ACTIAN_URL=
ACTIAN_API_KEY=
ACTIAN_COLLECTION=firevolv_labels

# --- Router thresholds ---
BLOCK_THRESHOLD=0.80
PASS_THRESHOLD=0.20
RETRIEVAL_K=3
